  format          MatchFormat
  published       Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  playEvent PlayEventDetails @relation(fields: [playEventId], references: [eventId], onDelete: Cascade)
  createdBy User             @relation("FormationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  slots     FormationSlot[]

  @@index([playEventId, updatedAt])
  @@index([createdByUserId])
  @@index([deletedAt])
}

model FormationSlot {
  id          String         @id @default(cuid())
  formationId String
  userId      String?
  team        TeamSide
  position    PlayerPosition
  label       String         @db.VarChar(32)
  x           Float
  y           Float

  formation Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([formationId, team])
  @@index([userId])
}

model Team {
  id                  String     @id @default(cuid())
  communityId         String     @unique
  createdByUserId     String
  name                String     @db.VarChar(120)
  city                String?    @db.VarChar(100)
  houma               String?    @db.VarChar(100)
  badgeUrl            String?
  status              TeamStatus @default(ACTIVE)
  isPublic            Boolean    @default(true)
  acceptingChallenges Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  community          Community              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy          User                   @relation("TeamCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  players            TeamPlayer[]
  lineups            TeamLineup[]
  challengesSent     TeamChallenge[]        @relation("TeamChallengeChallenger")
  challengesReceived TeamChallenge[]        @relation("TeamChallengeChallenged")
  homeGames          TeamGame[]             @relation("TeamGameHome")
  awayGames          TeamGame[]             @relation("TeamGameAway")
  messages           TeamChallengeMessage[]

  @@index([status, isPublic, acceptingChallenges, createdAt])
  @@index([city, houma])
  @@index([createdByUserId])
  @@index([deletedAt])
}

model TeamPlayer {
  id          String          @id @default(cuid())
  teamId      String
  userId      String?
  displayName String          @db.VarChar(120)
  shirtNumber Int?
  position    PlayerPosition?
  photoUrl    String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  lineupSlots TeamLineupSlot[]

  @@index([teamId, isActive])
  @@index([userId])
}

model TeamLineup {
  id              String          @id @default(cuid())
  teamId          String
  createdByUserId String
  name            String          @db.VarChar(80)
  formation       String          @db.VarChar(32)
  matchFormat     TeamMatchFormat @default(ELEVEN_V_ELEVEN)
  isCurrent       Boolean         @default(false)
  isPublished     Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User             @relation("TeamLineupCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  slots     TeamLineupSlot[]

  @@index([teamId, isCurrent, isPublished])
  @@index([createdByUserId])
  @@index([deletedAt])
}

model TeamLineupSlot {
  id        String         @id @default(cuid())
  lineupId  String
  playerId  String?
  role      PlayerPosition
  x         Float
  y         Float
  isStarter Boolean        @default(true)
  sortOrder Int            @default(0)

  lineup TeamLineup  @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  player TeamPlayer? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([lineupId, isStarter, sortOrder])
  @@index([playerId])
}

model TeamChallenge {
  id                    String              @id @default(cuid())
  challengerTeamId      String
  challengedTeamId      String
  proposedByCommunityId String
  challengedCommunityId String
  status                TeamChallengeStatus @default(PENDING)
  proposedStartsAt      DateTime?
  proposedVenue         String?             @db.VarChar(160)
  proposedFormat        TeamMatchFormat?
  message               String?             @db.VarChar(500)
  acceptedByUserId      String?
  declinedByUserId      String?
  cancelledByUserId     String?
  acceptedAt            DateTime?
  declinedAt            DateTime?
  cancelledAt           DateTime?
  expiresAt             DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  challengerTeam Team                   @relation("TeamChallengeChallenger", fields: [challengerTeamId], references: [id], onDelete: Cascade)
  challengedTeam Team                   @relation("TeamChallengeChallenged", fields: [challengedTeamId], references: [id], onDelete: Cascade)
  acceptedBy     User?                  @relation("TeamChallengeAccepter", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  declinedBy     User?                  @relation("TeamChallengeDecliner", fields: [declinedByUserId], references: [id], onDelete: SetNull)
  cancelledBy    User?                  @relation("TeamChallengeCanceller", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  proposedBy     Community              @relation("TeamChallengeProposedCommunity", fields: [proposedByCommunityId], references: [id], onDelete: Cascade)
  challenged     Community              @relation("TeamChallengeChallengedCommunity", fields: [challengedCommunityId], references: [id], onDelete: Cascade)
  game           TeamGame?
  messages       TeamChallengeMessage[]

  @@index([challengerTeamId, status, createdAt])
  @@index([challengedTeamId, status, createdAt])
  @@index([proposedByCommunityId, status, createdAt])
  @@index([challengedCommunityId, status, createdAt])
  @@index([expiresAt])
}

model TeamChallengeMessage {
  id          String    @id @default(cuid())
  challengeId String
  teamId      String
  userId      String
  body        String    @db.VarChar(500)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  challenge TeamChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  team      Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([challengeId, createdAt, id])
  @@index([teamId, createdAt])
  @@index([userId])
  @@index([deletedAt])
}

model TeamGame {
  id          String           @id @default(cuid())
  challengeId String           @unique
  homeTeamId  String
  awayTeamId  String
  status      TeamGameStatus   @default(SCHEDULING)
  scheduledAt DateTime?
  venueName   String?          @db.VarChar(160)
  matchFormat TeamMatchFormat?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  challenge TeamChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  homeTeam  Team          @relation("TeamGameHome", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam  Team          @relation("TeamGameAway", fields: [awayTeamId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt, id])
  @@index([homeTeamId, scheduledAt])
  @@index([awayTeamId, scheduledAt])
}

model FanHub {
  id              String    @id @default(cuid())
