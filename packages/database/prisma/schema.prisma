  @@index([eventId, enabled, sortOrder])
}

model RideOfferPaymentMethod {
  id          String        @id @default(cuid())
  rideOfferId String
  method      PaymentMethod
  enabled     Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  offer RideOffer @relation(fields: [rideOfferId], references: [id], onDelete: Cascade)

  @@unique([rideOfferId, method])
  @@index([rideOfferId, enabled, sortOrder])
}

model FundraiserPaymentMethod {
  id           String        @id @default(cuid())
  fundraiserId String
