  paymentIntentId         String    @unique
  telegramPaymentChargeId String    @unique @db.VarChar(200)
  providerPaymentChargeId String?   @db.VarChar(200)
  invoicePayload          String    @unique @db.VarChar(200)
  starsAmount             Int
  createdAt               DateTime  @default(now())
  refundedAt              DateTime?

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
}

model ProviderWebhookEvent {
