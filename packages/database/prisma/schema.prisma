  paymentIntent PaymentIntent  @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)

  @@unique([communityId, userId, sku])
  @@index([userId, revokedAt])
  @@index([productId])
}

model Formation {
  id              String      @id @default(cuid())
  playEventId     String
  createdByUserId String
