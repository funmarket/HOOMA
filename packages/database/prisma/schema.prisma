  createdAt        DateTime  @default(now())
  voidedAt         DateTime?
  voidedByUserId   String?

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  receivedBy    User          @relation("CashReceiver", fields: [receivedByUserId], references: [id], onDelete: Restrict)
  voidedBy      User?         @relation("CashVoider", fields: [voidedByUserId], references: [id], onDelete: Restrict)

  @@index([receivedByUserId, receivedAt])
  @@index([voidedByUserId])
}

model TelegramStarPayment {
