model PaymentAttempt {
  id                   String               @id @default(cuid())
  paymentIntentId      String
  method               PaymentMethod
  provider             PaymentProvider
  status               PaymentAttemptStatus @default(CREATED)
  idempotencyKey       String               @unique @db.VarChar(180)
  providerCheckoutId   String?              @db.VarChar(200)
  providerPaymentId    String?              @db.VarChar(200)
  providerAmountAtomic String?              @db.VarChar(120)
  providerCurrency     String?              @db.VarChar(16)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  completedAt          DateTime?

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)

  @@index([paymentIntentId, status, createdAt])
  @@index([provider, providerPaymentId])
}

model CashSettlement {
  id               String    @id @default(cuid())
  paymentIntentId  String    @unique
  receivedByUserId String
  amountMinor      BigInt
  currency         String    @db.VarChar(8)
  receivedAt       DateTime  @default(now())
