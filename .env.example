# APP_BASE_URL may be omitted/unset only for the first API bootstrap; set it before Mini App browser traffic.
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hooma?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hooma?schema=public
REDIS_URL=redis://localhost:6379
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
INIT_DATA_MAX_AGE_SECONDS=86400
DEV_AUTH_BYPASS=true
DEV_TELEGRAM_USER_ID=100000001
RATE_LIMIT_STORE=memory
